# Create a bot at https://discord.com/developers/applications
DISCORD_TOKEN=replace-me

# Create a Telegram bot by messaging @BotFather, then paste its token here.
TELEGRAM_BOT_TOKEN=replace-me
# Optional comma-separated Telegram user IDs. Empty means anyone can use the bot.
TELEGRAM_ALLOWED_USER_IDS=

# Optional configuration
KEVIN_PREFIX=k
KEVIN_DATABASE=data/kevin.sqlite3
KEVIN_STATUS=keeping the server tidy
# Set a Twitch or YouTube URL to show Discord's purple Streaming presence.
KEVIN_STREAM_URL=
# A comma-separated list of Discord user IDs allowed to use owner commands.
KEVIN_OWNER_IDS=
# Set to one development server ID for immediate slash-command syncing.
KEVIN_TEST_GUILD_ID=
# Optional cookie file for age-gated/restricted music sources.
YTDLP_COOKIE_FILE=

# Optional: required for Twitch go-live alerts. Create an app at dev.twitch.tv/console.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional: required for YouTube live alerts. Enable YouTube Data API v3 in Google Cloud.
YOUTUBE_API_KEY=

# Optional: enables short, web-searching AI replies when somebody mentions K.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Optional: model used by the /imagine command (gpt-image-1, dall-e-3, dall-e-2).
OPENAI_IMAGE_MODEL=gpt-image-1

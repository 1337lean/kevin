[Unit]
Description=Kevin Discord and Telegram bots
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/apps/kevin
EnvironmentFile=%h/apps/kevin/.env
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/lean/apps/kevin/bin:/usr/local/bin:/usr/bin:/bin
Environment=OPUS_LIBRARY=/home/lean/apps/kevin/vendor/usr/lib/x86_64-linux-gnu/libopus.so.0
ExecStart=%h/apps/kevin/.venv/bin/kevin-both
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=default.target
